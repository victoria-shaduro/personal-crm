# Copy to .env and fill in the values. Never commit .env.

# PostgreSQL in Docker (compose.yaml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Connection string for the app, format:
# postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/POSTGRES_DB
# On the server, use db instead of localhost; see README.md.
DATABASE_URL=
