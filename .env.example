# Copy to .env and fill in the values. Never commit .env.

# PostgreSQL in Docker (compose.yaml)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Connection string for the app, format:
# postgresql://POSTGRES_USER:POSTGRES_PASSWORD@localhost:5432/POSTGRES_DB
# On the server, use db instead of localhost; see README.md.
DATABASE_URL=

# Account for existing CRM records and demo data
OWNER_EMAIL=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
