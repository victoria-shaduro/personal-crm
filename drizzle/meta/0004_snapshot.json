        "contacts_birth_date_check": {
          "name": "contacts_birth_date_check",
          "value": "\n      (\"contacts\".\"birth_month\" IS NULL AND \"contacts\".\"birth_day\" IS NULL AND \"contacts\".\"birth_year\" IS NULL)\n      OR (\"contacts\".\"birth_month\" IS NOT NULL AND \"contacts\".\"birth_month\" BETWEEN 1 AND 12\n        AND \"contacts\".\"birth_day\" IS NOT NULL AND \"contacts\".\"birth_day\" BETWEEN 1 AND 31\n        AND (\"contacts\".\"birth_year\" IS NULL OR \"contacts\".\"birth_year\" BETWEEN 1 AND 9999))\n    "
        },
        "contacts_keep_in_touch_check": {
          "name": "contacts_keep_in_touch_check",
          "value": "\n      (\"contacts\".\"keep_in_touch_interval_days\" IS NULL AND \"contacts\".\"next_contact_at\" IS NULL)\n      OR (\"contacts\".\"keep_in_touch_interval_days\" IS NOT NULL\n        AND \"contacts\".\"keep_in_touch_interval_days\" IN (7, 30, 90, 365)\n        AND \"contacts\".\"next_contact_at\" IS NOT NULL)\n    "
        }
      },
